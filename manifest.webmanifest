    { "name": "Training", "short_name": "Training", "url": "./?mode=training", "icons": [{ "src": "./assets/icons/icon-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Story", "short_name": "Story", "url": "./?mode=story", "icons": [{ "src": "./assets/icons/icon-96.png", "sizes": "96x96", "type": "image/png" }] }
