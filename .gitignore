# Python bytecode from tools/
__pycache__/
*.pyc

# Node is only used to run tests/; nothing is installed to play the game.
node_modules/

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp

# MUGEN packages a human dropped in for the importer to inspect. These are
# third-party archives whose rights are exactly what this pipeline exists to
# establish, so none of them may ever be committed. The importer reads from
# here; it writes only to assets/import-staging/.
imports/mugen/*
!imports/mugen/README.md

# Import staging. This is the importer's output, and for a third-party package
# it is largely a re-encoding of that package's own data — the AIR actions, the
# state blocks, the per-frame collision boxes. Committing it would redistribute
# the package in a different file format, before the rights question it exists
# to answer has been answered. Staging is a working area; the conclusions live
# in reports/.
assets/import-staging/*
!assets/import-staging/README.md
